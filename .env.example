# Zabir Boutiques v8 — Environment Variables
#
# Two categories:
#   1. Build-time variables (CF_*) — used by `npm run build:snapshots`
#      to read D1 from a read-only token at build time. These run in
#      Node, not in the Worker.
#   2. Runtime secrets — set per-environment via `wrangler secret put`.
#      Never commit real values; only the example placeholders below.
#      For local dev, copy the relevant block to .env.local (astro dev)
#      and dist/server/.dev.vars (wrangler dev).
#
# Required runtime secrets (deploy WILL fail without these):
#   SESSION_SECRET                HMAC key for sessions + CSRF (>= 32 bytes)
#   PASSWORD_PEPPER               PBKDF2 password pepper (>= 32 bytes)
#   API_KEY_PEPPER                HMAC pepper for external API keys (>= 32 bytes)
#   AUDIT_LEDGER_SECRET           HMAC key for audit log chain (>= 32 bytes)
#   TOTP_CIPHER_KEY               AES-GCM key for Owner TOTP secrets (>= 32 bytes)
#   BACKUP_ENCRYPTION_KEY         AES-256-GCM key for D1 backups (32+ bytes)
#   TINIFY_API_KEY                Image compression
#   UDDOKTAPAY_API_KEY            Payment gateway
#   UDDOKTAPAY_BASE_URL           https://sandbox.uddoktapay.com (or prod)
#   UDDOKTAPAY_WEBHOOK_SECRET     HMAC secret for payment webhooks
#   FRAUDBD_API_KEY               Fraud scoring
#   DEEPSEEK_API_KEY              AI fallback
#   OPENAI_API_KEY                OpenAI-compatible endpoint (optional)
#   TURNSTILE_SECRET_KEY          Bot defense (optional in dev)
#   RESEND_API_KEY                Transactional email
#   RESEND_FROM_EMAIL             Sender identity (default: orders@zabirboutiques.com)
#   CF_API_TOKEN                  Cloudflare API token (cache purges)
#   CF_ZONE_ID                    Cloudflare zone ID (cache purges)

# Build-time D1 snapshot access (Cloudflare Pages build only)
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_D1_READ_TOKEN=

# ── Auth / security (REQUIRED) ─────────────────────────────────────────
SESSION_SECRET=
PASSWORD_PEPPER=
API_KEY_PEPPER=
AUDIT_LEDGER_SECRET=
TOTP_CIPHER_KEY=
BACKUP_ENCRYPTION_KEY=

# ── Cloudflare API (cache purges; optional in dev) ────────────────────
CF_API_TOKEN=
CF_ZONE_ID=

# ── Payments ──────────────────────────────────────────────────────────
UDDOKTAPAY_API_KEY=
UDDOKTAPAY_BASE_URL=https://sandbox.uddoktapay.com
UDDOKTAPAY_WEBHOOK_SECRET=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_BASE_URL=
SSLCOMMERZ_WEBHOOK_SECRET=

# ── Bot defense ───────────────────────────────────────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Fraud ─────────────────────────────────────────────────────────────
FRAUDBD_API_KEY=

# ── AI ────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
OPENAI_API_KEY=
AI_FALLBACK_KEY=
AI_FALLBACK_URL=

# ── Image ─────────────────────────────────────────────────────────────
TINIFY_API_KEY=
IMAGIFY_API_KEY=

# ── Email ─────────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@zabirboutiques.com

# ── Couriers (optional in dev) ────────────────────────────────────────
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_BASE_URL=
STEADFAST_API_KEY=
STEADFAST_SECRET=
STEADFAST_BASE_URL=
REDX_API_TOKEN=
REDX_BASE_URL=

# ── Dev-only flags ────────────────────────────────────────────────────
ALLOW_DEV_PHONE_OTP=

