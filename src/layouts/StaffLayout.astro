---
import "@/styles/global.css";
import type { StaffUser } from "@/lib/rbac";
import { menuForRole } from "@/lib/staff-menu";
import { readCsrfCookie } from "@/lib/csrf";
import Navbar from "@/components/staff/layout/Navbar.astro";
import Sidebar from "@/components/staff/layout/Sidebar.astro";
import Toast from "@/components/primitives/Toast.astro";

type Props = {
  title: string;
  user: StaffUser;
};

const { title, user } = Astro.props;
const csrfToken = readCsrfCookie(Astro.request) ?? "";
const currentPath = Astro.url.pathname;
const menu = menuForRole(user.role).map((item) => ({
  ...item,
  active: item.href === currentPath || (item.href !== "/staff" && currentPath.startsWith(item.href)),
}));

const roleLabel: Record<string, string> = {
  super_admin: "Super Admin",
  owner: "Owner",
  manager: "Manager",
  salesman: "Sales Staff",
  packing: "Packing Staff",
  staff: "Staff",
  viewer: "Viewer",
  support: "Support",
  developer: "Developer",
  auditor: "Auditor",
};

const roleColor: Record<string, string> = {
  super_admin: "chip-danger",
  owner: "chip-brand",
  manager: "",
  salesman: "",
  packing: "",
  staff: "",
  viewer: "",
  support: "",
  developer: "",
  auditor: "",
};
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="theme-color" content="#faf9f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1816" media="(prefers-color-scheme: dark)" />
    <meta name="zb-csrf" content={csrfToken} />
    <title>{title} - Zabir Boutiques Staff</title>
  </head>
  <body class="m-0 bg-bg font-sans text-ink">
    <Toast />
    <div class="staff-shell">
      <Navbar user={user} roleLabel={roleLabel[user.role] ?? user.role} roleColorClass={roleColor[user.role] || ""} />

      <div class="flex">
        <Sidebar menu={menu} currentPath={currentPath} />

        <main class="min-w-0 flex-1 p-4 sm:p-6">
          <slot />
        </main>
      </div>
    </div>

    <script>
      import '@/scripts/staff-shell';
    </script>
  </body>
</html>
