---
import StaffLayout from "@/layouts/StaffLayout.astro";
import PageHeader from "@/components/staff/PageHeader.astro";
import { getCurrentStaffUser, can } from "../../../lib/rbac";
import { getEnv } from "../../../lib/env";

const user = await getCurrentStaffUser(Astro);
if (!user) return Astro.redirect("/staff/login");
if (!can(user.role, "products.manage")) return new Response("Forbidden", { status: 403 });

const env = getEnv(Astro);
const products = await env.DB.prepare(
  `SELECT p.id, p.name, p.slug, p.price_paisa, p.compare_price_paisa, p.status, p.is_featured, p.created_at,
          c.name as category_name,
          (SELECT COUNT(*) FROM product_variants WHERE product_id = p.id AND is_deleted = 0) as variant_count,
          (SELECT COALESCE(SUM(quantity), 0) FROM inventory_items ii JOIN product_variants pv ON pv.id = ii.variant_id WHERE pv.product_id = p.id) as total_stock
   FROM products p
   LEFT JOIN categories c ON c.id = p.category_id
   ORDER BY p.created_at DESC
   LIMIT 200`
).all<any>();
---

<StaffLayout title="Products" user={user}>
  <PageHeader title="Products" subtitle={`${products.results?.length || 0} products`} />

  <div class="overflow-x-auto border border-line rounded-lg mb-6">
    <table class="w-full border-collapse text-sm">
      <thead>
        <tr class="bg-surface-soft text-left">
          <th class="px-3 py-2.5 font-semibold">Name</th>
          <th class="px-3 py-2.5 font-semibold">Category</th>
          <th class="px-3 py-2.5 font-semibold">Price</th>
          <th class="px-3 py-2.5 font-semibold">Compare</th>
          <th class="px-3 py-2.5 font-semibold text-center">Variants</th>
          <th class="px-3 py-2.5 font-semibold text-center">Stock</th>
          <th class="px-3 py-2.5 font-semibold">Status</th>
          <th class="px-3 py-2.5 font-semibold text-center">Featured</th>
        </tr>
      </thead>
      <tbody>
        {products.results?.length ? products.results.map(p => <tr class="border-t border-line-soft">
          <td class="px-3 py-2.5">
            <a href={`/staff/products/${p.id}`} class="text-brand no-underline font-semibold">{p.name}</a>
          </td>
          <td class="px-3 py-2.5 text-muted">{p.category_name || "—"}</td>
          <td class="px-3 py-2.5 font-semibold">৳{Math.floor(p.price_paisa / 100)}</td>
          <td class="px-3 py-2.5 text-muted">{p.compare_price_paisa ? `৳${Math.floor(p.compare_price_paisa / 100)}` : "—"}</td>
          <td class="px-3 py-2.5 text-center">{p.variant_count}</td>
          <td class="px-3 py-2.5 text-center">
            <span class={`font-semibold ${p.total_stock === 0 ? 'text-red-600' : p.total_stock < 20 ? 'text-amber-500' : 'text-green-600'}`}>{p.total_stock}</span>
          </td>
          <td class="px-3 py-2.5">
            <span class={`inline-block px-1.5 py-0.5 rounded text-[10px] font-semibold ${p.status === 'published' ? 'bg-green-100 text-green-800' : p.status === 'archived' ? 'bg-red-100 text-red-800' : 'bg-amber-100 text-amber-800'}`}>{p.status}</span>
          </td>
          <td class="px-3 py-2.5 text-center">{p.is_featured ? "⭐" : "—"}</td>
        </tr>) : <tr><td colspan="8" class="px-4 py-8 text-center text-muted">No products found.</td></tr>}
      </tbody>
    </table>
  </div>

  <div class="border border-line rounded-lg p-5 mt-2">
    <h2 class="text-base font-semibold m-0 mb-4">AI Content Generator</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
      <div>
        <label class="block text-xs text-ink-secondary mb-1">Product Name *</label>
        <input id="aiProductName" type="text" placeholder="e.g. Printed Cotton Kurti"
          class="w-full px-3 py-2 border border-line rounded-md text-sm bg-bg text-ink box-border" />
      </div>
      <div>
        <label class="block text-xs text-ink-secondary mb-1">Category</label>
        <input id="aiCategory" type="text" placeholder="e.g. Women's Fashion"
          class="w-full px-3 py-2 border border-line rounded-md text-sm bg-bg text-ink box-border" />
      </div>
      <div>
        <label class="block text-xs text-ink-secondary mb-1">Price (paisa)</label>
        <input id="aiPrice" type="number" placeholder="e.g. 129900"
          class="w-full px-3 py-2 border border-line rounded-md text-sm bg-bg text-ink box-border" />
      </div>
      <div>
        <label class="block text-xs text-ink-secondary mb-1">Key Features (comma-separated)</label>
        <input id="aiFeatures" type="text" placeholder="e.g. Soft fabric, Premium stitch"
          class="w-full px-3 py-2 border border-line rounded-md text-sm bg-bg text-ink box-border" />
      </div>
    </div>
    <div class="flex flex-wrap gap-2">
      <button id="aiGenerateBtn" class="px-4 py-2 bg-brand text-white rounded-md text-sm font-semibold border-0 cursor-pointer disabled:opacity-50" onclick="generateContent()">Generate with AI</button>
      <button id="aiCompareBtn" class="px-4 py-2 bg-surface-soft text-ink rounded-md text-sm font-semibold border border-line cursor-pointer disabled:opacity-50" onclick="compareContent()">Compare A/B (blind)</button>
    </div>
    <p class="text-xs text-muted mt-2 mb-0">Compare runs both AI providers on the same product and hides which is which until you pick. Costs two generations.</p>
    <div id="aiResult" class="hidden mt-4 border border-line rounded-lg p-4 bg-surface-soft text-sm whitespace-pre-wrap"></div>
    <div id="aiCompare" class="hidden mt-4"></div>
    <div id="aiError" class="hidden mt-4 text-red-700 text-sm"></div>
  </div>
</StaffLayout>

<script>
// @ts-nocheck
function getCsrf() {
  if (typeof window.__ZB_CSRF__ === 'string' && window.__ZB_CSRF__) return window.__ZB_CSRF__;
  try { return sessionStorage.getItem('zb-csrf') || ''; } catch (_) { return ''; }
}
async function generateContent() {
  const btn = document.getElementById('aiGenerateBtn');
  const result = document.getElementById('aiResult');
  const error = document.getElementById('aiError');
  btn.disabled = true;
  btn.textContent = 'Generating...';
  result.classList.add('hidden');
  error.classList.add('hidden');

  const name = document.getElementById('aiProductName').value.trim();
  if (!name) { error.textContent = 'Product name is required.'; error.classList.remove('hidden'); btn.disabled = false; btn.textContent = 'Generate with AI'; return; }

  try {
    const res = await fetch('/api/staff/ai/generate-product-content', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrf() },
      body: JSON.stringify({
        name,
        category: document.getElementById('aiCategory').value.trim() || undefined,
        price_paisa: parseInt(document.getElementById('aiPrice').value) || undefined,
        key_features: document.getElementById('aiFeatures').value.split(',').map(s => s.trim()).filter(Boolean)
      })
    });
    const data = await res.json();
    if (data.ok) {
      result.classList.remove('hidden');
      result.innerHTML = `<strong>Description:</strong>\n${esc(data.content.description)}\n\n<strong>Meta Title:</strong> ${esc(data.content.metaTitle)}\n\n<strong>Meta Description:</strong> ${esc(data.content.metaDescription)}`;
    } else {
      error.textContent = data.error || 'Generation failed';
      error.classList.remove('hidden');
    }
  } catch (e) {
    error.textContent = 'Network error: ' + e.message;
    error.classList.remove('hidden');
  } finally {
    btn.disabled = false;
    btn.textContent = 'Generate with AI';
  }
}
function esc(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

function aiFields() {
  return {
    name: document.getElementById('aiProductName').value.trim(),
    category: document.getElementById('aiCategory').value.trim() || undefined,
    price_paisa: parseInt(document.getElementById('aiPrice').value) || undefined,
    key_features: document.getElementById('aiFeatures').value.split(',').map(s => s.trim()).filter(Boolean)
  };
}

// Metrics are rendered next to each option so the pick can be informed by
// something objective (length compliance, latency) as well as by taste.
function slotCard(label, slot) {
  const m = slot.metrics;
  const warn = (bad) => bad ? ' class="text-red-700"' : '';
  return '<div class="border border-line rounded-lg p-4 bg-surface-soft">' +
    '<div class="flex items-center justify-between mb-2">' +
      '<strong class="text-sm">Option ' + label.toUpperCase() + '</strong>' +
      '<button class="px-3 py-1 bg-brand text-white rounded-md text-xs font-semibold border-0 cursor-pointer" data-choice="' + label + '">Prefer this</button>' +
    '</div>' +
    '<div class="text-sm whitespace-pre-wrap mb-3">' + esc(slot.content.description) + '</div>' +
    '<div class="text-xs text-muted">' +
      '<div><strong>Meta title:</strong> ' + esc(slot.content.metaTitle) + '</div>' +
      '<div><strong>Meta description:</strong> ' + esc(slot.content.metaDescription) + '</div>' +
      '<div class="mt-2">' + m.words + ' words &middot; ' +
        '<span' + warn(m.metaTitleOverran) + '>title ' + m.metaTitleLength + '/60' + (m.metaTitleOverran ? ' (overran, trimmed)' : '') + '</span> &middot; ' +
        '<span' + warn(m.metaDescriptionOverran) + '>meta ' + m.metaDescriptionLength + '/160' + (m.metaDescriptionOverran ? ' (overran, trimmed)' : '') + '</span> &middot; ' +
        m.latencyMs + 'ms</div>' +
    '</div>' +
  '</div>';
}

async function compareContent() {
  const btn = document.getElementById('aiCompareBtn');
  const box = document.getElementById('aiCompare');
  const error = document.getElementById('aiError');
  const result = document.getElementById('aiResult');
  const fields = aiFields();
  if (!fields.name) { error.textContent = 'Product name is required.'; error.classList.remove('hidden'); return; }

  btn.disabled = true;
  btn.textContent = 'Comparing...';
  error.classList.add('hidden');
  result.classList.add('hidden');
  box.classList.add('hidden');

  try {
    const res = await fetch('/api/staff/ai/compare-product-content', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrf() },
      body: JSON.stringify(fields)
    });
    const data = await res.json();
    if (!data.ok) {
      error.textContent = data.error || 'Comparison failed';
      error.classList.remove('hidden');
      return;
    }
    box.innerHTML =
      '<div class="grid grid-cols-1 md:grid-cols-2 gap-3">' + slotCard('a', data.a) + slotCard('b', data.b) + '</div>' +
      '<div class="mt-3 flex items-center gap-2">' +
        '<button class="px-3 py-1 border border-line rounded-md text-xs font-semibold bg-bg text-ink cursor-pointer" data-choice="neither">Neither is usable</button>' +
        '<span class="text-xs text-muted">Providers stay hidden until you pick.</span>' +
      '</div>' +
      '<div id="aiReveal" class="hidden mt-3 text-sm"></div>';
    box.classList.remove('hidden');
    box.querySelectorAll('[data-choice]').forEach(function (el) {
      el.addEventListener('click', function () { recordChoice(data.trial_id, el.getAttribute('data-choice')); });
    });
  } catch (e) {
    error.textContent = 'Network error: ' + e.message;
    error.classList.remove('hidden');
  } finally {
    btn.disabled = false;
    btn.textContent = 'Compare A/B (blind)';
  }
}

async function recordChoice(trialId, choice) {
  const box = document.getElementById('aiCompare');
  const reveal = document.getElementById('aiReveal');
  box.querySelectorAll('[data-choice]').forEach(function (el) { el.disabled = true; });
  try {
    const res = await fetch('/api/staff/ai/trial-choice', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrf() },
      body: JSON.stringify({ trial_id: trialId, choice: choice })
    });
    const data = await res.json();
    if (!data.ok) { reveal.textContent = data.error || 'Could not record choice'; reveal.classList.remove('hidden'); return; }
    const names = { deepseek: 'DeepSeek', workers_ai: 'Workers AI', neither: 'Neither' };
    const tally = Object.keys(data.tally || {}).map(function (k) { return esc(names[k] || k) + ': ' + data.tally[k]; }).join(' &middot; ') || 'none yet';
    reveal.innerHTML =
      '<div><strong>Option A</strong> was ' + esc(names[data.slot_a_provider] || data.slot_a_provider) +
      ' &middot; <strong>Option B</strong> was ' + esc(names[data.slot_b_provider] || data.slot_b_provider) + '</div>' +
      '<div class="mt-1">You chose: <strong>' + esc(names[data.chosen_provider] || data.chosen_provider) + '</strong>' +
      (data.already_recorded ? ' (already recorded earlier)' : '') + '</div>' +
      '<div class="mt-1 text-muted">Running tally &mdash; ' + tally + '</div>';
    reveal.classList.remove('hidden');
  } catch (e) {
    reveal.textContent = 'Network error: ' + e.message;
    reveal.classList.remove('hidden');
  }
}
</script>
